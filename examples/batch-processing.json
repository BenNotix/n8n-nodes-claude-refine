{
	"name": "Claude Refine — bulk classification at 50% cost (batches)",
	"nodes": [
		{
			"parameters": {},
			"id": "b2c3d4e5-0000-4000-8000-000000000001",
			"name": "When clicking Test workflow",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [0, 0]
		},
		{
			"parameters": {
				"jsCode": "// Demo items — replace with your own data source\nreturn [\n\t{ json: { text: 'The delivery arrived two weeks late and the box was damaged.' } },\n\t{ json: { text: 'Absolutely love the product, five stars!' } },\n\t{ json: { text: 'How do I reset my password?' } },\n];"
			},
			"id": "b2c3d4e5-0000-4000-8000-000000000002",
			"name": "Items to classify",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [200, 0]
		},
		{
			"parameters": {
				"resource": "batch",
				"operation": "create",
				"requestsSource": "items",
				"customId": "=item-{{ $itemIndex }}",
				"model": "claude-haiku-4-5",
				"prompt": "=Classify the following customer message as one of: complaint, praise, question. Reply with the single word only.\n\n{{ $json.text }}",
				"maxTokens": 16
			},
			"id": "b2c3d4e5-0000-4000-8000-000000000003",
			"name": "Create Batch",
			"type": "n8n-nodes-claude-refine.claudeRefine",
			"typeVersion": 1,
			"position": [400, 0]
		},
		{
			"parameters": {
				"amount": 30
			},
			"id": "b2c3d4e5-0000-4000-8000-000000000004",
			"name": "Wait 30s",
			"type": "n8n-nodes-base.wait",
			"typeVersion": 1.1,
			"position": [600, 0]
		},
		{
			"parameters": {
				"resource": "batch",
				"operation": "get",
				"batchId": "={{ $('Create Batch').first().json.id }}"
			},
			"id": "b2c3d4e5-0000-4000-8000-000000000005",
			"name": "Poll Batch",
			"type": "n8n-nodes-claude-refine.claudeRefine",
			"typeVersion": 1,
			"position": [800, 0]
		},
		{
			"parameters": {
				"conditions": {
					"options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
					"conditions": [
						{
							"leftValue": "={{ $json.processing_status }}",
							"rightValue": "ended",
							"operator": { "type": "string", "operation": "equals" }
						}
					],
					"combinator": "and"
				}
			},
			"id": "b2c3d4e5-0000-4000-8000-000000000006",
			"name": "Ended?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2,
			"position": [1000, 0]
		},
		{
			"parameters": {
				"resource": "batch",
				"operation": "getResults",
				"batchId": "={{ $('Create Batch').first().json.id }}",
				"simplifyResults": true
			},
			"id": "b2c3d4e5-0000-4000-8000-000000000007",
			"name": "Get Results (one item per request)",
			"type": "n8n-nodes-claude-refine.claudeRefine",
			"typeVersion": 1,
			"position": [1200, -80]
		}
	],
	"connections": {
		"When clicking Test workflow": {
			"main": [[{ "node": "Items to classify", "type": "main", "index": 0 }]]
		},
		"Items to classify": {
			"main": [[{ "node": "Create Batch", "type": "main", "index": 0 }]]
		},
		"Create Batch": {
			"main": [[{ "node": "Wait 30s", "type": "main", "index": 0 }]]
		},
		"Wait 30s": {
			"main": [[{ "node": "Poll Batch", "type": "main", "index": 0 }]]
		},
		"Poll Batch": {
			"main": [[{ "node": "Ended?", "type": "main", "index": 0 }]]
		},
		"Ended?": {
			"main": [
				[{ "node": "Get Results (one item per request)", "type": "main", "index": 0 }],
				[{ "node": "Wait 30s", "type": "main", "index": 0 }]
			]
		}
	},
	"active": false,
	"settings": {},
	"pinData": {}
}
